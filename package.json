{
  "name": "identity-aa-sdk-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Identity-driven Account Abstraction SDK monorepo",
  "workspaces": [
    "packages/*",
    "demo",
    "tests"
  ],
  "scripts": {
    "dev": "vite demo",
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "test": "npm run test:contracts && npm run test:unit && npm run test:smoke",
    "test:unit": "tsx --test packages/*/tests/*.test.ts demo/tests/*.test.ts tests/*.test.ts",
    "test:contracts": "powershell -ExecutionPolicy Bypass -File ./scripts/run-forge.ps1 test",
    "build:contracts": "powershell -ExecutionPolicy Bypass -File ./scripts/run-forge.ps1 build",
    "chain": "powershell -ExecutionPolicy Bypass -File ./scripts/start-chain.ps1",
    "chain:bg": "powershell -ExecutionPolicy Bypass -File ./scripts/start-chain.ps1 -Background",
    "bundler": "tsx scripts/bundler.ts",
    "test:smoke": "tsx tests/smoke.test.ts"
  },
  "devDependencies": {
    "@clerk/clerk-react": "^5.61.9",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.2.2"
  }
}
